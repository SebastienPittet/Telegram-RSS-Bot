# Example environment for the Telegram RSS bot.
#
# Copy this file to `.env` at the repository root (git-ignored):
#
#     cp .env.example .env
#
# These variables are the fallback: they are only read when configuration.toml is
# missing or invalid. Injecting them directly (`docker run --env-file`, a
# Kubernetes Secret/ConfigMap) is the recommended path in production; the .env
# loader exists as a development convenience.

# General settings
TIME_INTERVAL_MIN=20
ENTRY_MAX_TIME_OLD=1200

# Bot configuration (token from @BotFather; the bot must be a channel admin)
BOT_TOKEN=YOUR BOT TOKEN
CHANNEL_ID=@YourChannel

# News, RSS feeds: URLs separated by commas and/or whitespace.
# Keep them on one line. A quoted multi-line value is accepted too, but is far
# easier to break when a shell or a ConfigMap renders it.
RSS_URLS=https://korben.info/feed,https://www.ictjournal.ch/taxonomy/term/404/feed,https://www.ictjournal.ch/taxonomy/term/31/feed,https://www.ictjournal.ch/taxonomy/term/406/feed,https://www.newsd.admin.ch/newsd/feeds/rss?lang=fr&org-nr=1&offer-nr=308,https://feeds.feedburner.com/TheHackersNews,https://mspoweruser.com/feed/,https://www.numerama.com/feed/

# Optional
# LOG_LEVEL=DEBUG
# HEARTBEAT_FILE=/tmp/telegram-rss-bot.heartbeat
